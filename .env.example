# 복사해서 .env 로 쓴다. .env 는 절대 커밋하지 않는다.
POSTGRES_USER=safer
POSTGRES_PASSWORD=change_me
POSTGRES_DB=safer

# 대용량 볼륨 위치(외장 디스크를 쓸 때만 변경)
DATA_ROOT=./.data

# pgvector | qdrant — 벤치마크 결과로 기본값을 정한다(docs/ADR.md ADR-002)
VECTOR_BACKEND=pgvector

# 로컬 LLM 사용 시. 키가 없으면 규칙 기반 목 응답으로 폴백한다.
LLM_MODEL=ollama/qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
